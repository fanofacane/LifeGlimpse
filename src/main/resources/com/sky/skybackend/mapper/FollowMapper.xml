<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.skybackend.mapper.FollowMapper">

    <!-- 获取关注列表ID -->
    <select id="getFollowIdList" resultType="java.lang.Integer">
        SELECT follow_id FROM follow WHERE user_id = #{userId}
    </select>
    <select id="batchCheckIsFollow" resultType="com.sky.skybackend.domain.pojo.Status">
        SELECT
        follow_id AS id,
        CASE WHEN COUNT(follow_id) > 0 THEN TRUE ELSE FALSE END AS status
        FROM
            follow
        WHERE
            user_id = #{userId}
        AND follow_id IN
        <foreach item="followedUserId" collection="followedUserIds" open="(" separator="," close=")">
            #{followedUserId}
        </foreach>
        GROUP BY
        follow_id
    </select>

</mapper>